		"wouter": "3.7.0",
		"@hono/node-server": "1.14.2",
		"hono": "4.7.10",
		"@hono/zod-validator": "0.2.2",
		"camelcase": "7.0.1",
		"chalk": "5.4.1",
		"commander": "9.5.0",
		"env-paths": "3.0.0",
		"glob": "8.1.0",
		"hanji": "0.0.5",
		"json-diff": "0.9.0",
		"minimatch": "7.4.6",
		"semver": "7.7.2",
